{
  "name": "library_scraper_api",
  "version": "1.0.0",
  "description": "Library web scraper",
  "main": "index.js",
  "scripts": {
    "start": "node ./src/v2/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "keywords": [
    "web scraper",
    "node.js",
    "cheerio",
    "puppeteer"
  ],
  "author": "Steven Anongo",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "dependencies": {
    "archiver": "8.0.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ipaddr.js": "1.9.1",
    "morgan": "^1.12.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "puppeteer": "^25.14.0"
  }
}
